#include <stdio.h>
#include <stdlib.h>

void heapify(int a[], int n) {
    int i, j, temp;
    for(i = n/2 - 1; i >= 0; i--) {
        j = i;
        while(2*j + 1 < n) {
            int max = 2*j + 1;
            if(max + 1 < n && a[max + 1] > a[max])
                max++;

            if(a[j] < a[max]) {
                temp = a[j];
                a[j] = a[max];
                a[max] = temp;
                j = max;
            } else {
                break;
            }
        }
    }
}

int main() {
    int n = 0, a[10], i, c;

    while(1) {
        printf("\n---- Priority Queue Using Max Heap ----\n");
        printf("1. Create Heap\n2. Extract Max\n3. Exit\n");
        printf("Enter your choice: ");
        scanf("%d", &c);

        switch(c) {
            case 1:
                printf("Enter number of elements (max 10): ");
                scanf("%d", &n);

                if(n > 10) {
                    printf("Error: Maximum allowed elements are 10!\n");
                    n = 0;
                    break;
                }

                printf("\nEnter elements:\n");
                for(i = 0; i < n; i++) {
                    printf("Element %d: ", i + 1);
                    scanf("%d", &a[i]);
                }

                heapify(a, n);

                printf("\nHeap After Construction:\n");
                for(i = 0; i < n; i++)
                    printf("%d\t", a[i]);
                printf("\n");
                break;

            case 2:
                if(n > 0) {
                    printf("\nMax element deleted: %d\n", a[0]);
                    a[0] = a[n-1];
                    n--;
                    heapify(a, n);

                    printf("\nHeap After Deletion:\n");
                    for(i = 0; i < n; i++)
                        printf("%d\t", a[i]);
                    printf("\n");
                } else {
                    printf("\nHeap is empty, nothing to delete.\n");
                }
                break;

            case 3:
                exit(0);

            default:
                printf("\nInvalid Choice! Try Again.\n");
        }
    }
    return 0;
}
